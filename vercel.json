{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "portfolio-template-ochre-rho.vercel.app" }],
      "destination": "https://adiarya.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/explorations",
      "destination": "/work",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/downloads/codex-usage-v1.0.0-macos.zip",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"Codex-Usage-macOS.zip\"" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
